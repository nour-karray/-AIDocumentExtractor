# Copier vers .env et remplir (ne pas commiter .env)

# Google AI Studio / Gemini
GEMINI_API_KEY=
# Modèle google-genai (éviter gemini-1.5-* : souvent 404 sur l’API actuelle)
GEMINI_MODEL=gemini-2.5-flash

# Authentification API FastAPI (optionnelle)
# Quand DOCUAI_AUTH_ENABLED=true, les endpoints metier demandent Authorization: Bearer <token>.
DOCUAI_AUTH_ENABLED=false
DOCUAI_AUTH_USERNAME=admin
# Pour une demo locale, vous pouvez utiliser un mot de passe en clair dans .env.
# DOCUAI_AUTH_PASSWORD=change-me
# Recommande: utiliser un hash PBKDF2 genere avec:
# python -c "from backend.app.auth import hash_password; print(hash_password('change-me'))"
# DOCUAI_AUTH_PASSWORD_HASH=
# Secret de signature des tokens. Si absent, le mot de passe/hash sert de secret de secours.
# DOCUAI_AUTH_TOKEN_SECRET=
# Duree de validite du token en minutes.
DOCUAI_AUTH_TOKEN_TTL_MINUTES=480

# STEG : EasyOCR en secours (très lent). 1 = activer si la référence OCR échoue souvent.
# STEG_ENABLE_EASYOCR=0

# Tesseract (Windows / PATH)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Pipeline local Docling + PaddleOCR + Qwen via Ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Temps maximum pour une extraction locale complete et pour la generation Qwen.
DOCUAI_EXTRACTION_TIMEOUT_SECONDS=120
OLLAMA_GENERATE_TIMEOUT_SECONDS=90
# Nombre maximum de caracteres Docling/PaddleOCR envoyes a Qwen.
LOCAL_PIPELINE_CONTENT_CHARS=16000
# PaddleOCR est tente, mais s'il est trop lent sur Windows le pipeline utilise OCR local rapide.
LOCAL_PIPELINE_PADDLEOCR_TIMEOUT_SECONDS=12
LOCAL_PIPELINE_FAST_OCR_TIMEOUT_SECONDS=15
LOCAL_PIPELINE_FAST_OCR_LANG=eng
# Apres fine-tuning LoRA et integration dans Ollama, remplacer par exemple:
# OLLAMA_MODEL=docuai-qwen2.5-lora:latest
# Détection Auto : installer les langues ara, fra, eng (tessdata) pour un meilleur OCR routeur.

# DPI raster PDF pour l'OCR « classification » (défaut 200 ; plus = meilleure précision, plus lent)
# ROUTER_OCR_PDF_DPI=200

# Dossier des JSON sauvegardés après extraction (sous-dossiers par type : receipt, medical_gemini, …)
# EXTRACTION_HISTORY_DIR=data/history/extractions
# Base SQLite de l'historique des extractions
# EXTRACTION_HISTORY_DB_PATH=data/history/extractions.db
